{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Local semantic constraints for a GrhSIM SimTop 50k candidate",
  "type": "object",
  "required": [
    "schema_version",
    "candidate_mode",
    "hypothesis",
    "evidence",
    "patch",
    "enable_options"
  ],
  "properties": {
    "hypothesis": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000,
      "pattern": "\\S",
      "not": {
        "pattern": "(?i)^\\s*(?:placeholder|dummy|todo|tbd|unknown|n/?a)\\s*[.!]?\\s*$"
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4000,
        "pattern": "\\S",
        "not": {
          "pattern": "(?i)^\\s*(?:placeholder|dummy|todo|tbd|unknown|n/?a)\\s*[.!]?\\s*$"
        }
      }
    },
    "patch": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1048576,
      "pattern": "\\n$"
    },
    "candidate_mode": {
      "type": "string",
      "enum": ["default-path", "explicit-options"]
    },
    "enable_options": {
      "type": "array",
      "maxItems": 64
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "candidate_mode": {
            "const": "default-path"
          }
        },
        "required": ["candidate_mode"]
      },
      "then": {
        "properties": {
          "enable_options": {
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "candidate_mode": {
            "const": "explicit-options"
          }
        },
        "required": ["candidate_mode"]
      },
      "then": {
        "properties": {
          "enable_options": {
            "minItems": 1
          }
        }
      }
    }
  ]
}
